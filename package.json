{
  "name": "sundial-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "高精度日晷设计系统 (TypeScript + WebGL2): 水平式 / 赤道式 / 任意朝向墙面式",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "vite-node tests/accuracyAudit.mts",
    "smoke": "vite-node tests/smoke.mts"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
